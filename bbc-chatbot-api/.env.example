# BBC Chatbot API — Environment Variables
# Copy to .env and fill in real values

# === REQUIRED ===
SUPABASE_URL=https://exwxdjfeoekfixnjsreq.supabase.co
SUPABASE_KEY=eyJ...your_service_role_key_here

# === AUTH ===
# JWT_SECRET: REQUIRED in production. The Bearer/JWT path fails closed (500) if
# empty and DEBUG=false. Same secret must sign login tokens (auth_routes._issue_jwt).
JWT_SECRET=change_me_to_a_long_random_string
# Basic Auth ops escape hatch (optional). Empty = Basic disabled; JWT still works.
API_USER=admin
API_PASS=change_me_in_production

# === AI (required for chatbot, optional for admin-only mode) ===
ANTHROPIC_API_KEY=sk-ant-...

# === CORS (JSON array OR comma-separated; BCT/BBC domains always merged in code) ===
# CRM embed: crm.buybusinessclass.com is a DIFFERENT origin than the bare domain,
# so add it here (Railway env, no code deploy) once the exact subdomain is confirmed:
#   e.g. append "https://crm.buybusinessclass.com" to the array below.
CORS_ORIGINS=["https://chat.buybusinessclass.com","https://bbc-admin-panel-eight.vercel.app","https://admin-panel-error.vercel.app","https://buybusinessclass.com","https://www.buybusinessclass.com","https://businessclass-tickets.com","https://www.businessclass-tickets.com","http://localhost:5173","http://localhost:5174"]

# === Admin panel (invite email links) ===
ADMIN_PANEL_URL=https://chat.buybusinessclass.com
# Invite set-password link TTL (minutes). Default in code: 1440 = 24h
INVITE_LINK_EXPIRY_MINUTES=1440

# === Postmark (invite + super alert emails) ===
POSTMARK_TOKEN=your-postmark-server-token-here
EMAIL_FROM=noreply@buybusinessclass.com
SUPER_ALERT_EMAIL=super@buybusinessclass.com

# === Cron abandoned conversations ===
CRON_SECRET=your-random-32-char-string
ABANDONED_TIMEOUT_MINUTES=30

# === OPTIONAL ===
DEBUG=false
DAILY_BUDGET=50.0
QDRANT_URL=
QDRANT_API_KEY=
REDIS_URL=
