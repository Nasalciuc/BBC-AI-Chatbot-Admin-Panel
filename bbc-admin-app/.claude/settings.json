{
  "permissions": {
    "allow": [
      "Write(src/**)",
      "Write(specs/**)",
      "Write(.claude/**)",
      "Edit(src/**)",
      "Edit(specs/**)",
      "Edit(.claude/**)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(tsc *)"
    ],
    "deny": [
      "Write(.env*)",
      "Edit(.env*)",
      "Write(node_modules/**)",
      "Bash(rm -rf /)"
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  }
}
