# BBC Admin Panel — Environment Variables
VITE_API_URL=http://localhost:8000
# Optional: extra CRM origins allowed to postMessage JWT (comma-separated)
# BBC *.buybusinessclass.com is always allowed.
# VITE_CRM_ORIGINS=https://crm.example.com
# Optional: the PostHog project's replay address. The chat panel links the visit that
# started a chat (Replay, under "Where they came from"); unset, there is no link.
# VITE_POSTHOG_REPLAY_URL=https://eu.posthog.com/project/<project id>/replay/

