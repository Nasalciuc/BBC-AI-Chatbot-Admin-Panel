{
  "name": "bbc-widget",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:bbc": "vite build --mode bbc",
    "build:bct": "vite build --mode bct",
    "build:all": "npm run build:bbc && npm run build:bct",
    "dev": "vite",
    "test": "node --test tests/first-contact.test.mjs && node --experimental-strip-types --test tests/reconcile.test.mjs"
  },
  "dependencies": {
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
